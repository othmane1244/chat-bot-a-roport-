# Copie ce fichier en .env et remplis les vraies valeurs au fur et à mesure
# des étapes suivantes. Rien n'est requis pour faire tourner l'étape 1.

ENVIRONMENT=development

# Étape 3 (connecteurs API vols/météo)
AERODATABOX_API_KEY=
OPENWEATHERMAP_API_KEY=

# Étape 5 (LLM)
GEMINI_API_KEY=
GROQ_API_KEY=

# Étapes 3-4 (cache, graphe, vecteur)
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
CHROMA_PERSIST_DIR=./chroma_data
